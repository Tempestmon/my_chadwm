# Generated by theme/generate.sh from theme/palette.env. Do not edit.
# dunst notification daemon, Ultraviolet theme. Started from scripts/run.sh
# with -config pointing here. Control it with dunstctl (see chadwm keys).

[global]
    # Placement: top-right of the monitor with keyboard focus, below the bar
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = 16x48
    width = 420
    height = 300
    notification_limit = 5
    indicate_hidden = yes

    # Look
    font = Iosevka 13
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    gap_size = 6
    separator_height = 2
    separator_color = frame
    corner_radius = 8
    progress_bar = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # Text
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Behaviour
    sort = yes
    history_length = 50
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open

# Low: quiet, disappears fast
[urgency_low]
    background = "#0f0b1d"
    foreground = "#8a82ad"
    frame_color = "#2a2048"
    highlight = "#8a82ad"
    timeout = 5

# Normal: violet frame, cyan progress bar (neon on the active element)
[urgency_normal]
    background = "#0f0b1d"
    foreground = "#e0dcf5"
    frame_color = "#b36bff"
    highlight = "#00e5ff"
    timeout = 8

# Critical: red frame, stays until dismissed
[urgency_critical]
    background = "#0f0b1d"
    foreground = "#f2efff"
    frame_color = "#ff4d8d"
    highlight = "#ff4d8d"
    timeout = 0
