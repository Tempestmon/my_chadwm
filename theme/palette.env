# Ultraviolet: the single source of truth for desktop colors.
# Edit here, then run ./generate.sh. Format: NAME=#rrggbb (no spaces, no quotes).

# Base layers (dark violet-blue)
BG=#0f0b1d
SURFACE=#1a1430
OVERLAY=#2a2048
MUTED=#8a82ad
FG=#e0dcf5
FG_BRIGHT=#f2efff

# Accents: neon only on active elements
ACCENT=#b36bff
ACCENT2=#00e5ff

# Semantic / terminal hues
RED=#ff4d8d
GREEN=#5af2a5
YELLOW=#ffd166
ORANGE=#ff9e64
BLUE=#7aa2ff
PINK=#ff79c6

# Bright variants for the terminal's 8-15 colors
BRIGHT_BLACK=#4a3f73
BRIGHT_RED=#ff7aa8
BRIGHT_GREEN=#8af7c0
BRIGHT_YELLOW=#ffe09a
BRIGHT_BLUE=#a3bfff
BRIGHT_MAGENTA=#cf9bff
BRIGHT_CYAN=#6ff0ff
