-- Generated by theme/generate.sh (my_chadwm repo) from theme/palette.env. Do not edit.
-- Ultraviolet for Neovim: base16 mapping via mini.base16, plus "neon on active" accents.
local ok, base16 = pcall(require, "mini.base16")
if not ok then
    vim.notify("ultraviolet: mini.base16 is not installed", vim.log.levels.ERROR)
    return
end

base16.setup({
    palette = {
        base00 = "@BG@",         -- default background
        base01 = "@SURFACE@",    -- lighter background (status line, popups)
        base02 = "@OVERLAY@",    -- selection background
        base03 = "@SUBTLE@",     -- comments, invisibles
        base04 = "@MUTED@",      -- dark foreground (status line text)
        base05 = "@FG@",         -- default foreground
        base06 = "@FG_BRIGHT@",  -- light foreground
        base07 = "@FG_BRIGHT@",  -- lightest foreground
        base08 = "@RED@",        -- variables, tags, diff deleted
        base09 = "@ORANGE@",     -- numbers, constants
        base0A = "@YELLOW@",     -- types, search
        base0B = "@GREEN@",      -- strings, diff added
        base0C = "@ACCENT2@",    -- regex, escapes, special
        base0D = "@BLUE@",       -- functions
        base0E = "@ACCENT@",     -- keywords
        base0F = "@PINK@",       -- deprecated, embedded
    },
    use_cterm = false,
})
vim.g.colors_name = "ultraviolet"

-- Neon only on active/attention elements
local set = vim.api.nvim_set_hl
set(0, "CursorLineNr", { fg = "@ACCENT2@", bold = true })
set(0, "Cursor", { fg = "@BG@", bg = "@ACCENT2@" })
set(0, "MatchParen", { fg = "@ACCENT2@", bold = true, underline = true })
set(0, "IncSearch", { fg = "@BG@", bg = "@ACCENT2@" })
set(0, "Search", { fg = "@BG@", bg = "@YELLOW@" })
set(0, "Visual", { bg = "@OVERLAY@" })
set(0, "WinSeparator", { fg = "@OVERLAY@" })
set(0, "FloatBorder", { fg = "@ACCENT@", bg = "@SURFACE@" })
