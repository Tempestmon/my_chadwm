* {
    bg-col:       @BG@;
    bg-col-light: @SURFACE@;
    border-col:   @ACCENT@;
    selected-col: @OVERLAY@;
    blue:         @ACCENT@;
    fg-col:       @FG@;
    fg-col2:      @ACCENT2@;
    grey:         @MUTED@;
    width:        600;
}
